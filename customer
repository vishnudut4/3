<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chaiwala</title>

<style>
body{
font-family:Arial;
background:#f4f4f4;
padding:15px;
}

.vendor{
background:white;
padding:15px;
margin-bottom:10px;
border-radius:10px;
box-shadow:0 2px 5px rgba(0,0,0,.1);
}

button{
padding:10px;
background:#ff9800;
color:white;
border:none;
border-radius:5px;
}
</style>

</head>
<body>

<h1>☕ Nearby Tea Vendors</h1>

<div id="vendors"></div>

<script>

fetch('../vendors.json')
.then(response => response.json())
.then(data => {

let html='';

data.forEach(vendor => {

html += `
<div class="vendor">

<h3>${vendor.name}</h3>

<p>City: ${vendor.city}</p>

<p>Tea Price: ₹${vendor.price}</p>

<a href="../vendor/order.html?vendor=${vendor.id}">
<button>Order Tea</button>
</a>

</div>
`;

});

document.getElementById('vendors').innerHTML = html;

});

</script>

</body>
</html>
